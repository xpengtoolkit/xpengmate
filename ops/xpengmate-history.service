# Daily EVConduit history sync for XpengMate.
#
# The history service is long-running; this only asks it to start a sync. The
# import itself is idempotent and replaces only the rows it created.
[Unit]
Description=XpengMate history sync from EVConduit
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/xpengmate/xpengmate
EnvironmentFile=/home/xpengmate/xpengmate/.env
ExecStart=/bin/sh -c 'curl -fsS -X POST -H "Authorization: Bearer $XPENG_PROVIDER_TOKEN" http://127.0.0.1:8100/sync'
TimeoutStartSec=120
