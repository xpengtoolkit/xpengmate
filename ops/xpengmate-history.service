# Daily EVConduit history sync for XpengMate.
#
# Runs the importer one-shot against the stack's database. Idempotent by design:
# it replaces only the rows the importer itself created.
[Unit]
Description=XpengMate history sync from EVConduit
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/xpengmate/xpengmate
ExecStart=/usr/bin/docker-compose run --rm history
TimeoutStartSec=1800
