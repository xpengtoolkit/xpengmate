        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Consumption per local calendar month, one series per tyres label, so a tyre\n-- change shows up as a change between the series.\nWITH base AS (\n  SELECT\n    d.car_id,\n    d.start_date,\n    d.distance,\n    d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km AS range_km,\n    c.efficiency\n  FROM drives d\n  INNER JOIN cars c ON c.id = d.car_id\n  WHERE d.car_id IN ($car_id)\n    AND d.start_date IS NOT NULL\n    AND d.distance IS NOT NULL\n    AND c.efficiency IS NOT NULL\n    AND d.start_${preferred_range}_range_km IS NOT NULL\n    AND d.end_${preferred_range}_range_km IS NOT NULL\n    AND d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km >= 0.1\n    AND convert_km(d.distance::numeric, '$length_unit') >= $min_distance\n    AND $__timeFilter(d.start_date)\n),\ntagged AS (\n  SELECT\n    b.*,\n    (SELECT s.label\n       FROM car_setups s\n      WHERE s.car_id = b.car_id\n        AND s.aspect = 'tyres'\n        AND timezone('$__timezone', timezone('UTC', b.start_date))::date\n            BETWEEN s.started_at AND COALESCE(s.ended_at, 'infinity'::date)\n      ORDER BY s.started_at DESC\n      LIMIT 1) AS tyres_label\n  FROM base b\n)\nSELECT\n  date_trunc('month', timezone('$__timezone', timezone('UTC', start_date))) AS \"time\",\n  round((sum(range_km * efficiency) / NULLIF(convert_km(sum(distance)::numeric, '$length_unit'), 0) * 100)::numeric, 1) AS \"consumption_$length_unit\",\n  COALESCE(tyres_label, 'Not recorded') AS \"tyres\"\nFROM tagged\nGROUP BY 1, 3\nORDER BY 1, 3;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Consumption over time by tyres",
      "type": "timeseries"
    },
