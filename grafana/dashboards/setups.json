      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Consumption per setup label, grouped by aspect. \"Not recorded\" is the\n-- baseline for aspects that have setups but no covering row for a drive.\nWITH aspects AS (\n  SELECT DISTINCT car_id, aspect\n  FROM car_setups\n),\nbase AS (\n  SELECT\n    d.car_id,\n    d.start_date,\n    d.distance,\n    d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km AS range_km,\n    c.efficiency\n  FROM drives d\n  INNER JOIN cars c ON c.id = d.car_id\n  WHERE d.car_id IN ($car_id)\n    AND d.start_date IS NOT NULL\n    AND d.distance IS NOT NULL\n    AND c.efficiency IS NOT NULL\n    AND d.start_${preferred_range}_range_km IS NOT NULL\n    AND d.end_${preferred_range}_range_km IS NOT NULL\n    AND d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km >= 0.1\n    AND convert_km(d.distance::numeric, '$length_unit') >= $min_distance\n    AND $__timeFilter(d.start_date)\n),\ntagged AS (\n  SELECT\n    b.*,\n    a.aspect,\n    (SELECT s.label\n       FROM car_setups s\n      WHERE s.car_id = b.car_id\n        AND s.aspect = a.aspect\n        AND timezone('$__timezone', timezone('UTC', b.start_date))::date\n            BETWEEN s.started_at AND COALESCE(s.ended_at, 'infinity'::date)\n      ORDER BY s.started_at DESC\n      LIMIT 1) AS setup_label\n  FROM base b\n  INNER JOIN aspects a ON a.car_id = b.car_id\n),\nagg AS (\n  SELECT\n    aspect,\n    setup_label,\n    sum(distance) AS distance_km,\n    sum(range_km * efficiency) AS energy_kwh\n  FROM tagged\n  GROUP BY aspect, setup_label\n)\nSELECT\n  initcap(replace(aspect, '_', ' ')) || ' · ' || COALESCE(setup_label, 'Not recorded') AS \"setup\",\n  aspect,\n  round((energy_kwh / NULLIF(convert_km(distance_km::numeric, '$length_unit'), 0) * 100)::numeric, 1) AS \"consumption_$length_unit\"\nFROM agg\nWHERE distance_km > 0 AND energy_kwh IS NOT NULL\nORDER BY CASE aspect\n    WHEN 'tyres' THEN 1\n    WHEN 'towing' THEN 2\n    WHEN 'roof_rack' THEN 3\n    WHEN 'loaded' THEN 4\n    ELSE 5\n  END,\n  setup_label NULLS FIRST;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Consumption by setup",
      "type": "barchart"
    },
