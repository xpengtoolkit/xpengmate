          "format": "table",
          "rawQuery": true,
          "rawSql": "-- One row per car, aspect and setup label. A drive belongs to the newest setup\n-- of each aspect (highest started_at) whose inclusive range covers the drive's\n-- local calendar day; a NULL label is the baseline, rendered \"Not recorded\".\nWITH aspects AS (\n  SELECT DISTINCT car_id, aspect\n  FROM car_setups\n),\nbase AS (\n  SELECT\n    d.car_id,\n    COALESCE(NULLIF(c.name, ''), 'Car ' || c.id::text) AS car_name,\n    c.efficiency,\n    d.start_date,\n    d.distance,\n    d.duration_min,\n    d.outside_temp_avg,\n    d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km AS range_km\n  FROM drives d\n  INNER JOIN cars c ON c.id = d.car_id\n  WHERE d.car_id = $car_id\n    AND d.start_date IS NOT NULL\n    AND d.distance IS NOT NULL\n    AND c.efficiency IS NOT NULL\n    AND d.start_${preferred_range}_range_km IS NOT NULL\n    AND d.end_${preferred_range}_range_km IS NOT NULL\n    AND d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km >= 0.1\n    AND convert_km(d.distance::numeric, '$length_unit') >= $min_distance\n    AND $__timeFilter(d.start_date)\n),\ntagged AS (\n  SELECT\n    b.*,\n    a.aspect,\n    (SELECT s.label\n       FROM car_setups s\n      WHERE s.car_id = b.car_id\n        AND s.aspect = a.aspect\n        AND timezone('$__timezone', timezone('UTC', b.start_date))::date\n            BETWEEN s.started_at AND COALESCE(s.ended_at, 'infinity'::date)\n      ORDER BY s.started_at DESC\n      LIMIT 1) AS setup_label\n  FROM base b\n  INNER JOIN aspects a ON a.car_id = b.car_id\n),\nagg AS (\n  SELECT\n    car_name,\n    aspect,\n    setup_label,\n    count(*) AS drives,\n    sum(distance) AS distance_km,\n    sum(range_km * efficiency) AS energy_kwh,\n    avg(outside_temp_avg) AS avg_outside_temp_c,\n    sum(distance) / NULLIF(sum(duration_min) / 60.0, 0) AS avg_speed_kmh\n  FROM tagged\n  GROUP BY car_name, aspect, setup_label\n)\nSELECT\n  car_name AS \"car\",\n  aspect,\n  COALESCE(setup_label, 'Not recorded') AS \"setup\",\n  drives,\n  round(convert_km(distance_km::numeric, '$length_unit'), 0) AS \"distance_$length_unit\",\n  round(energy_kwh::numeric, 2) AS \"energy_kwh\",\n  round((energy_kwh / NULLIF(convert_km(distance_km::numeric, '$length_unit'), 0) * 100)::numeric, 1) AS \"consumption_$length_unit\",\n  round(convert_celsius(avg_outside_temp_c, '$temp_unit')::numeric, 1) AS \"avg_outside_temp_$temp_unit\",\n  round(convert_km(avg_speed_kmh::numeric, '$length_unit'), 0) AS \"avg_speed_$length_unit\"\nFROM agg\nORDER BY car_name,\n  CASE aspect\n    WHEN 'tyres' THEN 1\n    WHEN 'towing' THEN 2\n    WHEN 'roof_rack' THEN 3\n    WHEN 'loaded' THEN 4\n    ELSE 5\n  END,\n  setup_label NULLS FIRST;\n",
          "refId": "A",
