<nav class="breadcrumb" aria-label="breadcrumbs">
  <ul>
    <li><.link navigate={~p"/"}>{gettext("Home")}</.link></li>
    <li class="is-active"><.link navigate={~p"/xpengmate"}>{gettext("XpengMate")}</.link></li>
  </ul>
</nav>

<div class="columns is-centered">
  <div class="column is-10">
    <h1 class="title is-3">XpengMate</h1>
    <p class="subtitle is-6">
      {gettext(
        "Live source, XPENG credentials, and the EVConduit history feed. Changes are applied by restarting the engine (a few seconds)."
      )}
    </p>

    <div class="buttons is-right">
      <button class="button is-small is-light" phx-click="refresh">
        <span class="icon"><i class="mdi mdi-refresh"></i></span>
        <span>{gettext("Refresh status")}</span>
      </button>
    </div>

    <%= if @loading do %>
      <progress class="progress is-small is-primary" max="100"></progress>
    <% end %>

    <%!-- ===================== LIVE SOURCE ===================== --%>
    <div class="card mb-5">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon mr-2"><i class="mdi mdi-access-point"></i></span>
          {gettext("Live data source")}
        </p>
      </header>
      <div class="card-content">
        <%= case @engine do %>
          <% nil -> %>
            <p class="has-text-grey">{gettext("Loading engine status…")}</p>
          <% {:error, reason} -> %>
            <div class="notification is-warning is-light">
              {gettext("Engine settings API unreachable: %{reason}", reason: reason)}
            </div>
          <% engine when is_map(engine) -> %>
            <div class="columns">
              <div class="column">
                <table class="table is-narrow is-fullwidth">
                  <tbody>
                    <tr>
                      <th>{gettext("Source")}</th>
                      <td>{source_label(engine["source"])}</td>
                    </tr>
                    <tr>
                      <th>{gettext("VIN")}</th>
                      <td>{fmt(engine["vin"])}</td>
                    </tr>
                    <tr>
                      <th>{gettext("Car state")}</th>
                      <td>
                        <%= if engine["soc"] do %>
                          {gettext("%{soc}% · %{km} km", soc: engine["soc"], km: engine["odometer_km"])}
                        <% else %>
                          <span class="has-text-grey">{gettext("via upstream provider")}</span>
                        <% end %>
                      </td>
                    </tr>
                    <tr>
                      <th>{gettext("XOS version")}</th>
                      <td>{fmt(engine["xos_version"])}</td>
                    </tr>
                    <%= if engine["last_error"] do %>
                      <tr>
                        <th>{gettext("Last error")}</th>
                        <td class="has-text-danger">{engine["last_error"]}</td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <div class="column">
                <%= if engine["upstream"] do %>
                  <h4 class="title is-6">{gettext("Upstream provider")}</h4>
                  <table class="table is-narrow is-fullwidth">
                    <tbody>
                      <tr>
                        <th>{gettext("URL")}</th>
                        <td><code>{engine["upstream"]["url"]}</code></td>
                      </tr>
                      <tr>
                        <th>{gettext("Reachable")}</th>
                        <td>
                          <%= if engine["upstream"]["ok"] do %>
                            <span class="has-text-success has-text-weight-semibold">{gettext("yes")}</span>
                          <% else %>
                            <span class="has-text-danger has-text-weight-semibold">{gettext("no")}</span>
                          <% end %>
                        </td>
                      </tr>
                      <%= if engine["upstream"]["cars"] do %>
                        <tr>
                          <th>{gettext("Car")}</th>
                          <td>
                            <%= for car <- engine["upstream"]["cars"] do %>
                              <span class="tag is-light mr-1">{car["vin"]} · {car["state"]}</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                      <%= if engine["upstream"]["latency_ms"] do %>
                        <tr>
                          <th>{gettext("Latency")}</th>
                          <td>{engine["upstream"]["latency_ms"]} ms</td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% end %>
              </div>
            </div>

        <% end %>

        <hr />

        <.form for={@source_form} id="source-form" phx-change="validate_source" phx-submit="save_source">
          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label">{gettext("Which source should the engine use?")}</label>
                <div class="control">
                  <div class="select is-fullwidth">
                    <select name="source[source]">
                      <option value="provider" selected={@source_form.params["source"] == "provider"}>
                        {gettext("Home Assistant provider (xpengtoolkit 0.6.16+) — recommended")}
                      </option>
                      <option value="ha" selected={@source_form.params["source"] == "ha"}>
                        {gettext("Home Assistant entities (fallback, no provider option needed)")}
                      </option>
                    </select>
                  </div>
                </div>
              </div>

              <%= if @source_form.params["source"] in ["provider", "ha"] do %>
                <div class="field">
                  <label class="label">
                    {if @source_form.params["source"] == "provider",
                      do: gettext("Provider URL (e.g. http://homeassistant.local:8200)"),
                      else: gettext("Home Assistant URL (e.g. http://homeassistant.local:8123)")}
                  </label>
                  <div class="control">
                    <input
                      class="input"
                      type="text"
                      name={if @source_form.params["source"] == "provider", do: "source[provider_url]", else: "source[ha_url]"}
                      value={if @source_form.params["source"] == "provider",
                        do: @source_form.params["provider_url"],
                        else: @source_form.params["ha_url"]}
                      placeholder="http://"
                    />
                  </div>
                </div>
                <div class="field">
                  <label class="label">
                    {if @source_form.params["source"] == "provider",
                      do: gettext("Provider token"),
                      else: gettext("Home Assistant long-lived token")}
                  </label>
                  <div class="control" id={"source-token-wrap-" <> (@source_form.params["source"] || "provider")} phx-update="ignore">
                    <input
                      class="input"
                      type="password"
                      name={if @source_form.params["source"] == "provider", do: "source[provider_token]", else: "source[ha_token]"}
                      value=""
                      placeholder={gettext("leave empty to keep the saved token")}
                      autocomplete="off"
                    />
                  </div>
                </div>
                <%= if @source_form.params["source"] == "ha" do %>
                  <div class="field">
                    <label class="label">{gettext("Entity prefix (e.g. xpeng_800783)")}</label>
                    <div class="control">
                      <input class="input" type="text" name="source[ha_entity_prefix]" value={@source_form.params["ha_entity_prefix"]} />
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="notification is-light">
                  {gettext(
                    "The native engine authenticates to XPENG itself. Install the credentials below, then switch the source to this."
                  )}
                </div>
              <% end %>
            </div>

            <div class="column is-4">
              <div class="field">
                <label class="label">{gettext("VIN")}</label>
                <div class="control">
                  <input class="input" type="text" name="source[vin]" value={@source_form.params["vin"]} />
                </div>
              </div>
              <div class="field">
                <label class="label">{gettext("Usable battery capacity (kWh)")}</label>
                <div class="control">
                  <input class="input" type="text" name="source[usable_battery_kwh]" value={@source_form.params["usable_battery_kwh"]} />
                </div>
                <p class="help">
                  {gettext("Only used to estimate live charge energy; XPENG does not publish it.")}
                </p>
              </div>
            </div>
          </div>

          <div class="buttons">
            <button class="button is-primary" type="submit">
              <span class="icon"><i class="mdi mdi-content-save"></i></span>
              <span>{gettext("Save & apply")}</span>
            </button>
            <button class="button is-light" type="button" phx-click="test_source">
              <span class="icon"><i class="mdi mdi-connection"></i></span>
              <span>{gettext("Test source")}</span>
            </button>
          </div>
        </.form>

        <%= if @test_result do %>
          <div class={"notification is-light " <> (if @test_result["ok"], do: "is-success", else: "is-danger")}>
            <p class="has-text-weight-semibold">{gettext("Test result")}</p>
            <pre class="is-size-7">{Jason.encode!(@test_result, pretty: true)}</pre>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- ===================== HISTORY ===================== --%>
    <div class="card mb-5">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon mr-2"><i class="mdi mdi-database-import"></i></span>
          {gettext("History from EVConduit (xpengcardata)")}
        </p>
      </header>
      <div class="card-content">
        <%= case @history do %>
          <% nil -> %>
            <p class="has-text-grey">{gettext("Loading history status…")}</p>
          <% {:error, reason} -> %>
            <div class="notification is-warning is-light">
              {gettext("History service unreachable: %{reason}", reason: reason)}
            </div>
          <% history when is_map(history) -> %>
            <div class="columns">
              <div class="column">
                <table class="table is-narrow is-fullwidth">
                  <tbody>
                    <tr>
                      <th>{gettext("Source")}</th>
                      <td>
                        <%= if history["configured"] do %>
                          <span class="has-text-success has-text-weight-semibold">{history["config"]["mode"]}</span>
                          <%= if history["config"]["mode"] == "supabase" do %>
                            <code>{history["config"]["supabase_url"]}</code>
                          <% else %>
                            <code>{history["config"]["api_url"]}</code>
                          <% end %>
                        <% else %>
                          <span class="has-text-warning has-text-weight-semibold">{gettext("not configured")}</span>
                        <% end %>
                      </td>
                    </tr>
                    <tr>
                      <th>{gettext("Sync running")}</th>
                      <td>
                        <%= if history["running"] do %>
                          <span class="tag is-info is-light">{gettext("yes")}</span>
                        <% else %>
                          <span class="tag is-light">{gettext("no")}</span>
                        <% end %>
                      </td>
                    </tr>
                    <%= if history["last_run"] && history["last_run"]["finished_at"] do %>
                      <tr>
                        <th>{gettext("Last sync")}</th>
                        <td>
                          <%= if history["last_run"]["ok"] do %>
                            <span class="has-text-success has-text-weight-semibold">{gettext("ok")}</span>
                          <% else %>
                            <span class="has-text-danger has-text-weight-semibold">{gettext("failed")}</span>
                          <% end %>
                          {history["last_run"]["finished_at"]}
                        </td>
                      </tr>
                    <% end %>
                    <%= if history["lag_days"] do %>
                      <tr>
                        <th>{gettext("Newest data")}</th>
                        <td>
                          {gettext("in XPengMate database: %{db} days old",
                            db: fmt(history["lag_days"]["database_vs_now"])
                          )}
                          <br />
                          {gettext("in the EVConduit source: %{src} days old",
                            src: fmt(history["lag_days"]["source_vs_now"])
                          )}
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <div class="column">
                <h4 class="title is-6">{gettext("Rows in XPengMate")}</h4>
                <table class="table is-narrow is-fullwidth is-size-7">
                  <thead>
                    <tr>
                      <th>{gettext("Table")}</th>
                      <th class="has-text-right">{gettext("Rows")}</th>
                      <th>{gettext("Newest")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for {key, label} <- [
                      {"drives", gettext("Drives")},
                      {"charges", gettext("Charging sessions")},
                      {"charge_samples", gettext("Charge samples")},
                      {"positions", gettext("Positions")},
                      {"states", gettext("States")}
                    ] do %>
                      <% info = (history["database"] || %{})["tables"] || %{} %>
                      <% row = info[key] || %{} %>
                      <tr>
                        <td>{label}</td>
                        <td class="has-text-right">{(history["database"] || %{})["counts"][key] || 0}</td>
                        <td>{age_text(row["age_hours"])}</td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>

            <%= if history["database"]["error"] do %>
              <div class="notification is-warning is-light">{history["database"]["error"]}</div>
            <% end %>

            <%= if history["last_run"] && history["last_run"]["log_tail"] do %>
              <details class="mb-4">
                <summary>{gettext("Last sync log")}</summary>
                <pre class="is-size-7" style="max-height: 240px; overflow: auto;">{history["last_run"]["log_tail"]}</pre>
              </details>
            <% end %>
        <% end %>

        <hr />

        <.form for={@history_form} id="history-form" phx-change="validate_history" phx-submit="save_history">
          <div class="columns">
            <div class="column is-4">
              <div class="field">
                <label class="label">{gettext("How should history be pulled?")}</label>
                <div class="control">
                  <div class="select is-fullwidth">
                    <select name="history[mode]">
                      <option value="api" selected={@history_form.params["mode"] == "api"}>
                        {gettext("EVConduit API key (normal account — full history)")}
                      </option>
                      <option value="supabase" selected={@history_form.params["mode"] == "supabase"}>
                        {gettext("EVConduit database (self-hosted operator only — full history)")}
                      </option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="field">
                <label class="label">{gettext("VIN")}</label>
                <div class="control">
                  <input class="input" type="text" name="history[vin]" value={@history_form.params["vin"]} />
                </div>
              </div>
              <p class="help">
                {gettext(
                  "A normal EVConduit account uses its API key (History → API in your EVConduit account). The database mode is only for someone who self-hosts EVConduit and holds its Supabase service-role key. Neither is needed if you only use live data plus XPENG export files."
                )}
              </p>
            </div>

            <div class="column">
              <%= if @history_form.params["mode"] == "api" do %>
                <div class="field">
                  <label class="label">{gettext("xpengcardata API key")}</label>
                  <div class="control" id="history-api-key-wrap" phx-update="ignore">
                    <input class="input" type="password" name="history[api_key]" value="" placeholder={gettext("leave empty to keep the saved key")} autocomplete="off" />
                  </div>
                  <p class="help">
                    {gettext("Your EVConduit API key. The versioned data API (/api/v1/xpeng) is cursor-paged, so this imports the account's full history: trips, charging sessions, GPS positions, tyre pressures, charge curves and online/asleep spans.")}
                  </p>
                </div>
                <div class="field">
                  <label class="label">{gettext("API base URL")}</label>
                  <div class="control">
                    <input class="input" type="text" name="history[api_url]" value={@history_form.params["api_url"]} placeholder="https://evconduit.com" />
                  </div>
                </div>
              <% else %>
                <div class="field">
                  <label class="label">{gettext("Supabase URL")}</label>
                  <div class="control">
                    <input class="input" type="text" name="history[supabase_url]" value={@history_form.params["supabase_url"]} placeholder="https://<project>.supabase.co" />
                  </div>
                </div>
                <div class="field">
                  <label class="label">{gettext("Supabase service-role key")}</label>
                  <div class="control" id="history-service-key-wrap" phx-update="ignore">
                    <input class="input" type="password" name="history[service_key]" value="" placeholder={gettext("leave empty to keep the saved key")} autocomplete="off" />
                  </div>
                  <p class="help">
                    {gettext("Read-only use from this server only. It bypasses row-level security, so treat it as a password.")}
                  </p>
                </div>
              <% end %>
              <div class="columns">
                <div class="column">
                  <div class="field">
                    <label class="label is-small">{gettext("Export zip directory")}</label>
                    <div class="control">
                      <input class="input is-small" type="text" name="history[export_zip]" value={@history_form.params["export_zip"]} placeholder="/data/exports" />
                    </div>
                    <p class="help">
                      {gettext("Optional: XPENG export zips joined onto positions for SoC, odometer and range.")}
                    </p>
                  </div>
                </div>
                <div class="column">
                  <div class="field">
                    <label class="label is-small">{gettext("Usable battery (kWh)")}</label>
                    <div class="control">
                      <input class="input is-small" type="text" name="history[usable_battery_kwh]" value={@history_form.params["usable_battery_kwh"]} />
                    </div>
                  </div>
                  <div class="field">
                    <label class="label is-small">{gettext("Car name")}</label>
                    <div class="control">
                      <input class="input is-small" type="text" name="history[car_name]" value={@history_form.params["car_name"]} />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="buttons">
            <button class="button is-primary" type="submit">
              <span class="icon"><i class="mdi mdi-content-save"></i></span>
              <span>{gettext("Save history source")}</span>
            </button>
            <button class="button is-info" type="button" phx-click="sync_history">
              <span class="icon"><i class="mdi mdi-sync"></i></span>
              <span>{gettext("Sync now")}</span>
            </button>
          </div>
        </.form>
      </div>
    </div>

    <%!-- ===================== EXPORT ZIPS ===================== --%>
    <div class="card mb-5">
      <header class="card-header">
        <p class="card-header-title">
          <span class="icon mr-2"><i class="mdi mdi-file-upload"></i></span>
          {gettext("XPENG data export files")}
        </p>
      </header>
      <div class="card-content">
        <p class="content is-small">
          {gettext(
            "Upload the GDPR export zips XPENG sends you (Data → Export). They are rolling 30-day windows, so uploading several is expected: the importer merges the windows and skips anything already in the database, then fills battery, odometer and range into existing GPS positions."
          )}
        </p>

        <%= case @exports do %>
          <% nil -> %>
            <p class="has-text-grey">{gettext("Loading export status…")}</p>
          <% {:error, reason} -> %>
            <div class="notification is-warning is-light">
              {gettext("Export status unavailable: %{reason}", reason: reason)}
            </div>
          <% exports when is_map(exports) -> %>
            <%= if exports["last_run"] && exports["last_run"]["finished_at"] do %>
              <% run = exports["last_run"] %>
              <% summary = run["summary"] || %{} %>
              <div class={"notification is-light " <> (if run["ok"], do: "is-success", else: "is-danger")}>
                <p class="has-text-weight-semibold">
                  {if run["ok"], do: gettext("Last import finished"), else: gettext("Last import failed")}
                  <span class="is-size-7 has-text-grey">{run["finished_at"]}</span>
                </p>
                <%= if summary != %{} do %>
                  <div class="content is-small">
                    <ul>
                      <li>{gettext("New files imported: %{n}", n: summary["files_imported"] || 0)}</li>
                      <li>{gettext("Duplicate uploads skipped: %{n}", n: summary["duplicates"] || 0)}</li>
                      <li>
                        {gettext("Drives: %{added} added, %{merged} extended, %{skipped} already covered",
                          added: summary["added_drives"] || 0,
                          merged: summary["merged_drives"] || 0,
                          skipped: summary["skipped_drives"] || 0
                        )}
                      </li>
                      <li>
                        {gettext("Charges: %{added} added, %{skipped} already covered",
                          added: summary["added_charges"] || 0,
                          skipped: summary["skipped_charges"] || 0
                        )}
                      </li>
                      <li>{gettext("States added: %{n}", n: summary["added_states"] || 0)}</li>
                      <li>{gettext("Positions enriched: %{n}", n: summary["enriched_positions"] || 0)}</li>
                    </ul>
                    <%= if (summary["added_drives"] || 0) + (summary["added_charges"] || 0) + (summary["added_states"] || 0) == 0 do %>
                      <p class="has-text-grey">
                        {gettext("No new rows were needed: everything in these files is already in the database.")}
                      </p>
                    <% end %>
                  </div>
                <% end %>
                <%= if run["log_tail"] do %>
                  <details>
                    <summary>{gettext("Import log")}</summary>
                    <pre class="is-size-7" style="max-height: 220px; overflow: auto;">{run["log_tail"]}</pre>
                  </details>
                <% end %>
              </div>
            <% end %>

            <%!-- phx-update="ignore" keeps the chosen files when the LiveView
                 status poll re-renders this card. --%>
            <form
              id="exports-form"
              phx-update="ignore"
              action="/xpengmate/exports"
              method="post"
              enctype="multipart/form-data"
            >
              <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
              <div class="field">
                <label class="label is-small" for="export-zips">{gettext("Export zips")}</label>
                <div class="control">
                  <%!-- A native, visible file input: the browser itself shows the
                       chosen file names / count, so picking files is never silent. --%>
                  <input
                    id="export-zips"
                    class="input"
                    type="file"
                    name="files[]"
                    multiple
                    accept=".zip,application/zip"
                    style="height:auto;padding:8px;"
                  />
                </div>
                <p class="help">
                  {gettext("Up to 12 files at once; each is stored on the history service and imported once.")}
                </p>
                <p id="export-selection" class="has-text-info is-size-7"></p>
              </div>

              <div class="buttons">
                <button class="button is-primary" type="submit">
                  <span class="icon"><i class="mdi mdi-database-import"></i></span>
                  <span>{gettext("Upload & import")}</span>
                </button>
                <%= if exports["running"] do %>
                  <span class="has-text-info has-text-weight-semibold">{gettext("import running…")}</span>
                <% end %>
              </div>
            </form>

            <script>
              (() => {
                const form = document.getElementById("exports-form");
                if (!form || form.dataset.selectionWired === "1") return;
                form.dataset.selectionWired = "1";
                const input = form.querySelector('input[type="file"]');
                const out = document.getElementById("export-selection");
                const render = () => {
                  const files = Array.from(input.files || []);
                  if (files.length === 0) {
                    out.textContent = "";
                    return;
                  }
                  const total = files.reduce((sum, file) => sum + file.size, 0);
                  out.textContent =
                    "Selected " +
                    files.length +
                    " file(s), " +
                    (total / 1048576).toFixed(1) +
                    " MB: " +
                    files.map((file) => file.name).join(", ") +
                    " — now click Upload & import.";
                };
                input.addEventListener("change", render);
                render();
              })();
            </script>

            <h4 class="title is-6">{gettext("Imported export files")}</h4>
            <%= if exports["imports"] == [] do %>
              <p class="has-text-grey is-size-7">{gettext("None yet.")}</p>
            <% else %>
              <table class="table is-narrow is-fullwidth is-size-7">
                <thead>
                  <tr>
                    <th>{gettext("File")}</th>
                    <th>{gettext("Window")}</th>
                    <th class="has-text-right">{gettext("Samples")}</th>
                    <th class="has-text-right">{gettext("Drives")}</th>
                    <th class="has-text-right">{gettext("Charges")}</th>
                    <th>{gettext("Imported")}</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for item <- exports["imports"] do %>
                    <tr>
                      <td><code>{item["filename"]}</code></td>
                      <td>{epoch_text(item["timer_start"])} → {epoch_text(item["timer_end"])}</td>
                      <td class="has-text-right">{item["samples"]}</td>
                      <td class="has-text-right">{item["drives"]}</td>
                      <td class="has-text-right">{item["charges"]}</td>
                      <td>{item["imported_at"]}</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
