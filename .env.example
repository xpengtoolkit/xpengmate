# XpengMate stack secrets. Copy to .env (mode 600) and fill in.
# Nothing in here is committed; .env is git-ignored.

# --- TeslaMate's token vault ------------------------------------------------
# Encrypts the provider token TeslaMate stores in Postgres. Losing it only
# means signing in again - but signing in again is what the engine's /token
# endpoint is for, so keep it stable anyway.
ENCRYPTION_KEY=

# Raises LiveView socket security; a random one is generated per boot if unset,
# which invalidates open browser sessions on restart.
SECRET_KEY_BASE=

# --- Postgres / Grafana -----------------------------------------------------
DATABASE_PASS=
GRAFANA_ADMIN_PASSWORD=

# --- The provider token -----------------------------------------------------
# xpengmate sends this as `TOKEN` (Authorization: Bearer) to the engine, and the
# engine requires it on every route except /healthz. Generate: openssl rand -hex 24
XPENG_PROVIDER_TOKEN=

# --- The car ----------------------------------------------------------------
XPENG_VIN=L1NNSGHA3SB800783
XPENG_USABLE_BATTERY_KWH=87.5

# Serve the provider API while the XPENG mTLS material is not mounted yet. The
# car reports offline; set to false once data/engine/certs and secrets exist.
XPENG_ALLOW_OFFLINE=true

# --- Distributed node (for `bin/teslamate rpc` sign-in) ---------------------
# Not used for clustering; it is how a headless deployment clicks TeslaMate's
# Sign in button, which is a LiveView form rather than a plain POST.
RELEASE_COOKIE=
RELEASE_NODE=xpengmate@127.0.0.1

# --- Compose project name (Compose v1 has no top-level name) ----------------
COMPOSE_PROJECT_NAME=xpengmate

# --- Where it listens -------------------------------------------------------
XPENGMATE_PORT=4100
GRAFANA_PORT=3003
TZ=Australia/Sydney
VIRTUAL_HOST=xpengmate.local

# --- EVConduit history source ----------------------------------------------
# Read-only Supabase credentials for the one-shot history importer. The service
# role key bypasses row-level security, so it belongs on the server (here) and
# nowhere else; rotate it in EVConduit if it ever leaves.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the path (inside the history container) of an XPENG GDPR export zip.
#   cp DA....zip data/exports/
#   XPENG_EXPORT_ZIP=/data/exports/DA....zip
# The export has 1 Hz SoC/odometer/range but no GPS; the GPS logger has the
# opposite. Joining them by timestamp gives positions both.
XPENG_EXPORT_ZIP=

# How the car is named in the xpengmate UI.
XPENG_CAR_NAME=XPeng G6
